<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Outbound network for Litterbox upload/download and ntfy polling -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Hardened runtime: allow reading user-selected profile files -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- Keychain access (keyring crate uses SecKeychainItem API) -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)app.zync.zensync</string>
  </array>
</dict>
</plist>
