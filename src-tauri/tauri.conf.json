{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZynC",
  "version": "0.1.0",
  "identifier": "app.zync.zensync",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZynC",
        "width": 420,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
